node_modules/
dist/
.DS_Store
*.log
.env
.env.*
!.env.example

# Finished clips are regenerated from sources. Do not commit video.
recordings/*
!recordings/.gitkeep
!recordings/INDEX.md

# Dropped footage. Photos and SVG slots stay in git.
# Git has no brace expansion, so each extension gets its own line.
src/assets/**/*.mp4
src/assets/**/*.mov
src/assets/**/*.webm
src/assets/**/*.gif

# Licensed music tracks stay on the machine that holds the licence.
src/assets/music/*
!src/assets/music/.gitkeep
# Beat maps are small derived text; keep them so scenes build without the track.
!src/assets/music/*.beats.json
!src/assets/music/*.beats.md
