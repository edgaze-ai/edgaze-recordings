{
  "name": "edgaze-motion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "ci": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build",
    "new": "node scripts/new-scene.mjs",
    "postinstall": "playwright install ffmpeg"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
